NODE_ENV=development
PORT=8080
MONGODB_URL=mongodb://user:password@host:port/database

# Podio shared OAuth credentials (same across all apps)
PODIO_CLIENT_ID=your-client-id
PODIO_CLIENT_SECRET=your-client-secret

# Webhook secret
PODIO_WEBHOOK_SECRET=your-webhook-secret

# Redis (required for BullMQ)
REDIS_URL=redis://localhost:6379

# Optional queue tuning
# BATCH_SIZE=500
# FLUSH_DELAY_MS=120000
# SEED_DELAY_MS=15000
